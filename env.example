# Anthropic API Key for Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL for Prisma (from Vercel Postgres)
DATABASE_URL=postgresql://username:password@host:port/database

# NextAuth Secret for authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here

# JWT Secret for authentication (legacy, can be same as NEXTAUTH_SECRET)
JWT_SECRET=your_jwt_secret_here

# Tavily API Key for web research (get from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here


# Google Custom Search API (alternative to Tavily)
# GOOGLE_SEARCH_API_KEY=a9202a627ba7b71ab0f385e69d9f54a76f77eca184d0eab6083808cfa4978bab
# GOOGLE_SEARCH_ENGINE_ID=a9202a627ba7b71ab0f385e69d9f54a76f77eca184d0eab6083808cfa4978bab