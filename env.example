# Anthropic API Key for Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL for Prisma (from Vercel Postgres)
DATABASE_URL=postgresql://username:password@host:port/database

# NextAuth Secret for authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here

# JWT Secret for authentication (legacy, can be same as NEXTAUTH_SECRET)
JWT_SECRET=your_jwt_secret_here

# Tavily API Key for web research (get from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API Key for Whisper speech-to-text (get from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Vercel Blob Storage Token (get from Vercel Dashboard → Settings → Environment Variables)
# After creating a Blob store in Vercel, this token will be automatically added
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Google Custom Search API (alternative to Tavily)
# GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
# GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here